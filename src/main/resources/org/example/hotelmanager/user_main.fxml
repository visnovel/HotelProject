<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.hotelmanager.UserMainController">
    <tabs>

        <Tab text="Поиск и бронирование">
            <VBox spacing="20.0" style="-fx-padding: 20; -fx-background-color: #FAFAFA;">
                <!-- Панель фильтров (Выбор дат) -->
                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <VBox spacing="5">
                        <Label text="Дата заезда" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <DatePicker fx:id="checkInPicker" promptText="Выберите дату" prefWidth="150.0"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Дата выезда" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <DatePicker fx:id="checkOutPicker" promptText="Выберите дату" prefWidth="150.0"/>
                    </VBox>
                    <Button text="Найти свободные номера" onAction="#onSearchClick" prefHeight="45.0"
                            style="-fx-background-color: #6200EE; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;">
                        <HBox.margin>
                            <Insets top="18.0" />
                        </HBox.margin>
                    </Button>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="cardsContainer" spacing="15.0" />
                </ScrollPane>

                <Button text="ПОДТВЕРДИТЬ БРОНИРОВАНИЕ" onAction="#onBookClick" maxWidth="Infinity" prefHeight="50.0"
                        style="-fx-background-color: #03DAC6; -fx-text-fill: #212121; -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand; -fx-background-radius: 8;"/>
            </VBox>
        </Tab>

        <Tab text="Личный кабинет">
            <StackPane style="-fx-padding: 20; -fx-background-color: #F5F5F5;">

                <VBox fx:id="authBox" spacing="25.0" alignment="CENTER">
                    <VBox spacing="10.0" maxWidth="400" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                        <Label text="Вход в аккаунт" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <TextField fx:id="emailLogin" promptText="Email" prefHeight="35.0"/>
                        <PasswordField fx:id="passwordLogin" promptText="Пароль" prefHeight="35.0"/>
                        <Button text="Войти" onAction="#onLoginClick" maxWidth="Infinity" prefHeight="40.0"
                                style="-fx-background-color: #6200EE; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </VBox>

                    <Label text="ИЛИ" style="-fx-text-fill: #999; -fx-font-weight: bold;"/>

                    <VBox spacing="10.0" maxWidth="400" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                        <Label text="Регистрация" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <TextField fx:id="nameReg" promptText="ФИО" prefHeight="35.0"/>
                        <HBox spacing="10.0">
                            <TextField fx:id="phoneReg" promptText="Телефон" HBox.hgrow="ALWAYS" prefHeight="35.0"/>
                            <TextField fx:id="passReg" promptText="Паспорт" HBox.hgrow="ALWAYS" prefHeight="35.0"/>
                        </HBox>
                        <TextField fx:id="emailReg" promptText="Email" prefHeight="35.0"/>
                        <PasswordField fx:id="passwordReg" promptText="Пароль" prefHeight="35.0"/>
                        <Button text="Создать профиль" onAction="#onRegisterClick" maxWidth="Infinity" prefHeight="40.0"/>
                    </VBox>
                </VBox>

                <VBox fx:id="profileBox" spacing="15.0" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label fx:id="welcomeLabel" text="Добро пожаловать!" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #6200EE;"/>
                        </VBox>
                        <Button text="Выйти" onAction="#onLogoutClick" style="-fx-background-color: #ffebee; -fx-text-fill: #c62828;"/>
                    </HBox>

                    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #ddd; -fx-border-radius: 10;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Ваш статус:" style="-fx-font-weight: bold;"/>
                            <Label fx:id="loyaltyStatusLabel" text="Новичок (0%)" style="-fx-text-fill: #6200EE; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="spentLabel" text="0 / 20 000 ₽" style="-fx-font-size: 11px;"/>
                        </HBox>
                        <ProgressBar fx:id="loyaltyProgress" progress="0.0" maxWidth="Infinity" prefHeight="15.0" style="-fx-accent: #6200EE;"/>
                        <Label fx:id="nextLevelLabel" text="До скидки 5% осталось 20 000 ₽" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    </VBox>

                    <VBox spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label text="История бронирований" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn prefWidth="100.0" text="Комната">
                                    <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn prefWidth="110.0" text="Заезд">
                                    <cellValueFactory><PropertyValueFactory property="checkIn"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn prefWidth="110.0" text="Выезд">
                                    <cellValueFactory><PropertyValueFactory property="checkOut"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn prefWidth="120.0" text="Итого (₽)">
                                    <cellValueFactory><PropertyValueFactory property="totalPrice"/></cellValueFactory>
                                </TableColumn>
                                <TableColumn prefWidth="130.0" text="Статус">
                                    <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                                </TableColumn>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <Button text="СКАЧАТЬ ЧЕК В .TXT" onAction="#onDownloadReceiptClick" maxWidth="Infinity" prefHeight="45.0"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Button>
                    </VBox>
                </VBox>
            </StackPane>
        </Tab>
    </tabs>
</TabPane>
